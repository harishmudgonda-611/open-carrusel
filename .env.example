# Optional self-hosted RPD image generation (ComfyUI)
# Default is loopback only. Never expose an unauthenticated ComfyUI server publicly.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Export your ComfyUI workflow in API format and set the absolute path:
COMFYUI_WORKFLOW_PATH=/absolute/path/to/comfyui-api-workflow.json
# IDs of Load Image and CLIP Text Encode nodes in that exported workflow:
COMFYUI_GARMENT_NODE_ID=10
COMFYUI_CHARACTER_NODE_ID=11
COMFYUI_PROMPT_NODE_ID=12
# Optional negative-prompt text node:
COMFYUI_NEGATIVE_PROMPT_NODE_ID=13
# Only set if intentionally using a secured remote/private gateway:
# COMFYUI_ALLOWED_HOSTS=comfyui.internal.example
# COMFYUI_BEARER_TOKEN=replace-with-gateway-token
